# {{ ansible_managed }}
# Fully generated from Terraform's dhcp_reservations (deploy.tf).
# Do not edit this file directly -- edit dhcpd.conf.j2 and re-run the
# playbook, or change the Terraform locals that produce dhcp_reservations.
#
# No pool/range is declared. A MAC either has a host{} entry below (and
# gets its exact reserved address) or it doesn't -- in which case dhcpd
# has nothing to offer it and simply does not respond. No arp-scan, no
# discovery, no dynamic leases.

default-lease-time 600;
max-lease-time 7200;
authoritative;

option domain-name "{{ domain_name }}";
option domain-name-servers {{ dns_servers | join(', ') }};

subnet {{ subnet }} netmask {{ netmask }} {
  option routers {{ router }};
}

{% for res in dhcp_reservations %}
host {{ res.name }} {
  hardware ethernet {{ res.mac }};
  fixed-address {{ res.ip }};
}
{% endfor %}
