{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["rbe", "buildbarn"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "title": "RBE Cluster Overview",
  "uid": "rbe-overview",
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "master_instance",
        "label": "Master host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"bb-storage\"}, instance)",
        "regex": "/^([^:]+):/",
        "includeAll": false,
        "multi": false,
        "refresh": 2
      },
      {
        "name": "worker",
        "label": "Worker host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"bb-worker\"}, instance)",
        "regex": "/^([^:]+):/",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cluster health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Targets up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "targets": [ { "expr": "sum(up)", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Targets down",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "count(up == 0) or vector(0)", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Target up/down by job",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 }, "min": 0, "max": 1 } },
      "targets": [ { "expr": "up", "legendFormat": "{{job}} / {{instance}}", "refId": "A" } ]
    },

    {
      "type": "row",
      "title": "Master",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Master liveness",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 }
        }
      },
      "targets": [
        { "expr": "up{job=~\"bb-storage|bb-scheduler|bb-browser|prometheus\", instance=~\"^$master_instance:.*\"}", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Master CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=~\"bb-storage|bb-scheduler|bb-browser|prometheus\", instance=~\"^$master_instance:.*\"}[5m]) * 100", "legendFormat": "{{job}}", "refId": "B" },
        { "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"^$master_instance:.*\"}[5m])))", "legendFormat": "node total", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Master RAM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=~\"bb-storage|bb-scheduler|bb-browser|prometheus\", instance=~\"^$master_instance:.*\"}", "legendFormat": "{{job}}", "refId": "C" },
        { "expr": "node_memory_MemTotal_bytes{instance=~\"^$master_instance:.*\"} - node_memory_MemAvailable_bytes{instance=~\"^$master_instance:.*\"}", "legendFormat": "node used", "refId": "B" },
        { "expr": "node_memory_MemTotal_bytes{instance=~\"^$master_instance:.*\"}", "legendFormat": "node available", "refId": "A" }
      ]
    },

    {
      "type": "timeseries",
      "title": "Tasks scheduled/sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "sum(rate(buildbarn_builder_in_memory_build_queue_tasks_scheduled_total{instance=~\"^$master_instance:.*\"}[5m]))", "legendFormat": "tasks scheduled/sec", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed lookups/writes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "sum(rate(buildbarn_blobstore_hashing_key_location_map_get_too_many_attempts_total{instance=~\"^$master_instance:.*\"}[5m]))", "legendFormat": "failed lookups/sec", "refId": "A" },
        { "expr": "sum(rate(buildbarn_blobstore_hashing_key_location_map_put_too_many_iterations_total{instance=~\"^$master_instance:.*\"}[5m]))", "legendFormat": "failed writes/sec", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eviction rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "sum(rate(buildbarn_eviction_set_operations_total{instance=~\"^$master_instance:.*\"}[5m]))", "legendFormat": "evictions/sec", "refId": "A" }
      ]
    },

    {
      "type": "row",
      "title": "Worker: $worker",
      "repeat": "worker",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "type": "timeseries",
      "title": "Worker liveness",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 }
        }
      },
      "targets": [
        { "expr": "up{job=\"bb-worker\", instance=~\"^$worker:.*\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"bb-worker\", instance=~\"^$worker:.*\"}[5m]) * 100", "legendFormat": "bb-worker", "refId": "B" },
        { "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"^$worker:.*\"}[5m])))", "legendFormat": "node total", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker RAM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"bb-worker\", instance=~\"^$worker:.*\"}", "legendFormat": "bb-worker", "refId": "C" },
        { "expr": "node_memory_MemTotal_bytes{instance=~\"^$worker:.*\"} - node_memory_MemAvailable_bytes{instance=~\"^$worker:.*\"}", "legendFormat": "node used", "refId": "B" },
        { "expr": "node_memory_MemTotal_bytes{instance=~\"^$worker:.*\"}", "legendFormat": "node available", "refId": "A" }
      ]
    }
  ]
}